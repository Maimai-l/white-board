{
  "manifest_version": 3,
  "name": "白板速写",
  "version": "1.2.0",
  "description": "在 iPad 上用 Apple Pencil 随手写，在工具栏弹出的速写里复制为 PNG。需要 Mac 上正在运行白板应用。",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "速写（Alt+Shift+S）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "打开速写"
    }
  }
}

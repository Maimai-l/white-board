{
  "manifest_version": 3,
  "name": "白板速写",
  "version": "1.2.0",
  "description": "在 iPad 上用 Apple Pencil 随手写，在侧边栏里复制或拖出 PNG。需要 Mac 上正在运行白板应用。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开速写（Alt+Shift+S）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "打开速写"
    }
  }
}
